/* GOOGLE FONT */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:'Inter', sans-serif;
}

body{
  background:#f4f7fb;
  display:flex;
  color:#222;
}

/* SIDEBAR */

.sidebar{
  width:260px;
  height:100vh;
  background:#111827;
  color:white;
  padding:25px;
  position:fixed;
  left:0;
  top:0;
  overflow-y:auto;
}

.sidebar h2{
  margin-bottom:40px;
  color:#60a5fa;
  font-size:28px;
  font-weight:700;
}

.sidebar ul{
  list-style:none;
}

.sidebar ul li{
  margin-bottom:18px;
}

.sidebar ul li a{
  color:#d1d5db;
  text-decoration:none;
  font-size:16px;
  display:block;
  padding:12px 14px;
  border-radius:10px;
  transition:0.3s;
}

.sidebar ul li a:hover{
  background:#1f2937;
  color:white;
}

/* MAIN CONTENT */

.main-content{
  margin-left:260px;
  width:calc(100% - 260px);
  padding:30px;
}

/* TOPBAR */

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:30px;
  gap:20px;
}

.topbar h1{
  font-size:32px;
  color:#111827;
}

.topbar input{
  padding:12px 18px;
  border:none;
  border-radius:10px;
  width:260px;
  background:white;
  box-shadow:0 2px 8px rgba(0,0,0,0.08);
  outline:none;
  font-size:14px;
}

/* SUMMARY CARDS */

.summary-cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:20px;
  margin-bottom:35px;
}

.card{
  background:white;
  padding:25px;
  border-radius:18px;
  box-shadow:0 3px 12px rgba(0,0,0,0.08);
  transition:0.3s;
}

.card:hover{
  transform:translateY(-4px);
}

.card h3{
  color:#6b7280;
  margin-bottom:10px;
  font-size:16px;
  font-weight:500;
}

.card h2{
  font-size:32px;
  color:#111827;
}

/* PIPELINE */

.pipeline{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  margin-bottom:40px;
}

.pipeline-column{
  background:white;
  border-radius:18px;
  padding:20px;
  min-height:320px;
  box-shadow:0 3px 12px rgba(0,0,0,0.08);
}

.pipeline-column h3{
  margin-bottom:20px;
  font-size:18px;
  color:#111827;
}

/* LEAD CARD */

.lead-card{
  background:#f9fafb;
  padding:15px;
  border-radius:12px;
  margin-bottom:15px;
  border-left:5px solid #60a5fa;
  transition:0.3s;
  cursor:pointer;
}

.lead-card:hover{
  transform:translateX(5px);
}

.lead-card h4{
  margin-bottom:5px;
  color:#111827;
}

.lead-card p{
  font-size:14px;
  color:#6b7280;
}

/* TABLE SECTION */

.table-section{
  background:white;
  padding:25px;
  border-radius:18px;
  box-shadow:0 3px 12px rgba(0,0,0,0.08);
  margin-bottom:40px;
  overflow-x:auto;
}

.table-section h2{
  margin-bottom:20px;
  color:#111827;
}

table{
  width:100%;
  border-collapse:collapse;
}

table th,
table td{
  text-align:left;
  padding:15px;
  border-bottom:1px solid #eee;
}

table th{
  color:#6b7280;
  font-size:14px;
  font-weight:600;
}

table td{
  font-size:15px;
}

/* STATUS BADGES */

.status{
  padding:6px 12px;
  border-radius:20px;
  font-size:13px;
  font-weight:600;
}

.active{
  background:#dcfce7;
  color:#16a34a;
}

.pending{
  background:#fef3c7;
  color:#ca8a04;
}

/* TASK SECTION */

.tasks{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.task-card{
  background:white;
  padding:20px;
  border-radius:18px;
  box-shadow:0 3px 12px rgba(0,0,0,0.08);
  transition:0.3s;
}

.task-card:hover{
  transform:translateY(-4px);
}

.task-card h4{
  margin-bottom:10px;
  color:#111827;
}

.task-card p{
  color:#6b7280;
  margin-bottom:15px;
  font-size:14px;
  line-height:1.5;
}

.task-card button{
  padding:10px 18px;
  border:none;
  border-radius:10px;
  background:#2563eb;
  color:white;
  cursor:pointer;
  font-size:14px;
  transition:0.3s;
}

.task-card button:hover{
  background:#1d4ed8;
}

/* SCROLLBAR */

::-webkit-scrollbar{
  width:8px;
}

::-webkit-scrollbar-thumb{
  background:#cbd5e1;
  border-radius:10px;
}

/* RESPONSIVE DESIGN */

@media(max-width:1000px){

  .pipeline{
    grid-template-columns:repeat(2,1fr);
  }

}

@media(max-width:768px){

  body{
    flex-direction:column;
  }

  .sidebar{
    width:100%;
    height:auto;
    position:relative;
  }

  .main-content{
    margin-left:0;
    width:100%;
    padding:20px;
  }

  .pipeline{
    grid-template-columns:1fr;
  }

  .summary-cards{
    grid-template-columns:1fr;
  }

  .topbar{
    flex-direction:column;
    align-items:flex-start;
  }

  .topbar input{
    width:100%;
  }

  .tasks{
    grid-template-columns:1fr;
  }

}
